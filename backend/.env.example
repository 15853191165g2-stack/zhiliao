# ============ 复制为 .env 后按需修改 ============

# ---- 运行环境 ----
ENV=dev
APP_NAME=知了 API

# ---- 数据库 ----
# 开发（默认，无需安装任何数据库）：
DATABASE_URL=sqlite+aiosqlite:///./quanzhi.db
# 生产（PostgreSQL）：
# DATABASE_URL=postgresql+asyncpg://quanzhi:password@127.0.0.1:5432/quanzhi

# ---- AI（智谱 GLM，OpenAI 兼容协议）----
# 不填 API Key 也能跑：会自动降级为本地规则摘要（LocalSummarizer）
# 免费获取：https://open.bigmodel.cn 手机号注册 → API Keys → 创建
#   glm-4.7-flash 是官方**长期免费**模型（输入/输出/缓存全免，200K 上下文）
#   注意免费档并发只有 1
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
AI_API_KEY=
AI_MODEL=glm-4.7-flash
AI_TIMEOUT=60
# 送进模型的正文字数上限（控成本）
AI_MAX_INPUT_CHARS=6000
AI_TEMPERATURE=0.2
# ⚠️ GLM-4.7-Flash 是推理模型，思维链计入 max_tokens，且会把额度吃光导致
#    返回空 content。摘要属于「抽取」不是「推理」，这里默认关掉思考。
#    若改用非推理模型，保持 false 也无副作用。
AI_THINKING=false
# 用 JSON 模式约束输出格式
AI_USE_JSON_MODE=true

# ---- 抓取合规 ----
RESPECT_ROBOTS=true
FETCH_CONCURRENCY=4
# 同一域名两次请求的最小间隔（秒），需求要求 ≥2；调小请自行承担被限流风险
FETCH_MIN_INTERVAL=2.0
FETCH_TIMEOUT=20
# 请在 UA 里留一个真实联系邮箱，方便站点管理员联系你
USER_AGENT=QuanZhiBot/0.1 (+contact: you@example.com)

# ---- 定时刷新 ----
TIMEZONE=Asia/Shanghai
REFRESH_CRON_HOURS=8,18
REFRESH_CRON_MINUTE=0
ENABLE_SCHEDULER=true
